{
  "name": "tilework",
  "version": "0.4.0",
  "description": "Run many coding agents side by side on an infinite canvas of real terminals. Built for Linux.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --ozone-platform-hint=auto",
    "build": "electron-vite build",
    "start": "electron-vite preview -- --ozone-platform-hint=auto",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "spike:zoom": "electron spikes/zoom/run.mjs --ozone-platform-hint=auto",
    "dist": "electron-vite build && electron-builder --linux AppImage --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaorii-ako/tilework.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kaorii-ako/tilework/issues"
  },
  "homepage": "https://github.com/kaorii-ako/tilework#readme",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron-winstaller": false
  },
  "private": true,
  "build": {
    "appId": "dev.kaorii.tilework",
    "productName": "Tilework",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "hooks",
        "to": "hooks"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "tilework",
      "synopsis": "Coding agents side by side on an infinite canvas",
      "syncDesktopName": true
    },
    "artifactName": "Tilework-${version}-${arch}.${ext}"
  },
  "productName": "Tilework",
  "author": "Tawin Tangsukson",
  "desktopName": "tilework.desktop"
}
